  // 用途：默认角色列表
  // 说明：系统启动时自动创建的默认角色
  "default_roles": [
    {
      // 用途：角色名称
      // 说明：管理员角色
      "name": "admin",
      // 用途：角色描述
      // 说明：管理员角色，拥有所有权限
      "description": "管理员角色，拥有所有权限",
      // 用途：权限列表
      // 说明：* 表示所有权限
      "permissions": ["*"]
    },
    {
      // 用途：角色名称
      // 说明：普通用户角色
      "name": "user",
      // 用途：角色描述
      // 说明：普通用户角色，拥有基础权限
      "description": "普通用户角色，拥有基础权限",
      // 用途：权限列表
      // 说明：普通用户只能访问AI相关功能
      "permissions": ["ai:hub:view", "ai:model:view", "ai:usage:view"]
    }
  ]
}
