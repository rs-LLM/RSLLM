{
  // 用途：默认权限配置文件
  // 说明：定义系统初始化时的默认权限列表

  // 用途：权限类型定义
  // 说明：menu-菜单权限，button-按钮权限，api-API权限
  "permission_types": [
    "menu",
    "button",
    "api"
  ],

  // 用途：默认权限列表
  // 说明：系统启动时自动创建的默认权限
  "default_permissions": [
    {
      // 用途：权限名称
      // 说明：用户管理菜单
      "name": "用户管理",
      // 用途：权限标识
      // 说明：用于权限验证的唯一标识
      "permission": "sys:user:view",
      // 用途：权限路径
      // 说明：前端路由路径
      "path": "/system/user",
      // 用途：权限类型
      // 说明：菜单权限
      "permission_type": "menu",
      // 用途：权限描述
      // 说明：查看用户管理页面
      "description": "查看用户管理页面",
      // 用途：排序字段
      // 说明：用于菜单排序
      "sort_order": 1,
      // 用途：前端图标
      // 说明：菜单图标
      "icon": "user",
      // 用途：状态
      // 说明：1-启用，0-禁用
      "status": 1
    },
    {
      "name": "用户添加",
      "permission": "sys:user:add",
      "path": "/admin/sys_user_add",
      "permission_type": "button",
      "description": "添加新用户",
      "sort_order": 1,
      "status": 1
    },
    {
      "name": "用户编辑",
      "permission": "sys:user:edit",
      "path": "/admin/sys_user_update",
      "permission_type": "button",
      "description": "编辑用户信息",
      "sort_order": 2,
      "status": 1
    },
    {
      "name": "用户删除",
      "permission": "sys:user:delete",
      "path": "/admin/sys_user_remove",
      "permission_type": "button",
      "description": "删除用户",
      "sort_order": 3,
      "status": 1
    },
    {
      "name": "角色管理",
      "permission": "sys:role:view",
      "path": "/system/role",
      "permission_type": "menu",
      "description": "查看角色管理页面",
      "sort_order": 2,
      "icon": "role",
      "status": 1
    },
    {
      "name": "角色添加",
      "permission": "sys:role:add",
      "path": "/admin/sys_role_add",
      "permission_type": "button",
      "description": "添加新角色",
      "sort_order": 1,
      "status": 1
    },
    {
      "name": "角色编辑",
      "permission": "sys:role:edit",
      "path": "/admin/sys_role_update",
      "permission_type": "button",
      "description": "编辑角色信息",
      "sort_order": 2,
      "status": 1
    },
    {
      "name": "角色删除",
      "permission": "sys:role:delete",
      "path": "/admin/sys_role_delete",
      "permission_type": "button",
      "description": "删除角色",
      "sort_order": 3,
      "status": 1
    },
    {
      "name": "权限管理",
      "permission": "sys:permission:view",
      "path": "/system/permission",
      "permission_type": "menu",
      "description": "查看权限管理页面",
      "sort_order": 3,
      "icon": "permission",
      "status": 1
    },
    {
      "name": "权限添加",
      "permission": "sys:permission:add",
      "path": "/admin/sys_permission_add",
      "permission_type": "button",
      "description": "添加新权限",
      "sort_order": 1,
      "status": 1
    },
    {
      "name": "权限编辑",
      "permission": "sys:permission:edit",
      "path": "/admin/sys_permission_update",
      "permission_type": "button",
      "description": "编辑权限信息",
      "sort_order": 2,
      "status": 1
    },
    {
      "name": "权限删除",
      "permission": "sys:permission:delete",
      "path": "/admin/sys_permission_remove",
      "permission_type": "button",
      "description": "删除权限",
      "sort_order": 3,
      "status": 1
    },
    {
      "name": "字典管理",
      "permission": "sys:dict:view",
