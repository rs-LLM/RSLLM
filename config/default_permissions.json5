    },
    {
      "name": "字典删除",
      "permission": "sys:dict:delete",
      "path": "/admin/sys_dict_remove",
      "permission_type": "button",
      "description": "删除字典",
      "sort_order": 3,
      "status": 1
    },
    {
      "name": "AI Hub",
      "permission": "ai:hub:view",
      "path": "/ai/hub",
      "permission_type": "menu",
      "description": "查看AI Hub页面",
      "sort_order": 10,
      "icon": "ai",
      "status": 1
    },
    {
      "name": "模型管理",
      "permission": "ai:model:view",
      "path": "/ai/model",
      "permission_type": "menu",
      "description": "查看模型管理页面",
      "sort_order": 11,
      "icon": "model",
      "status": 1
    },
    {
      "name": "模型编辑",
      "permission": "sys:model:edit",
      "path": "/admin/model_update",
